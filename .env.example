TELEGRAM_BOT_TOKEN=
DAILY_TIME=09:00
TIMEZONE=UTC
# Comma-separated Telegram user IDs allowed to use /add
ADMIN_IDS=
# Comma-separated chat IDs; empty allows all chats
ALLOWED_CHATS=
# Set to a public https URL to use webhook mode instead of polling
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=8080

# Genius API token for fetch_songs.py (https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=
